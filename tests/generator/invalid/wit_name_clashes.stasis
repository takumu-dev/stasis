interface test:wit_clashes@1.0.0;

group npc_on_hit {}

script npc {
    uses world, combat;
    fn tick(frame_count: u64, framecount: u64);
    optional fn on_hit();
    optional fn describe();
    optional fn get_up();
    optional fn getup();
    fn hit();
    fn last_words(a: last_hit, b: lasthit);
    fn lastwords();
}

group npc_describe {}
group npc_hit {}
group npcdescribe {}

group world {
    record last_hit { x: u8, y_pos: u8, ypos: u8 }

    object entity {
        fn entity();
        fn get_name();
        fn getname();
        fn rename(s_elf: u8, self: u8);
    }
}

group combat {
    use world::{last_hit};

    record lasthit { x: u8 }
}

//! wit_name_clashes.stasis:7:31: error: parameter `framecount` of entry point `npc.tick` and parameter `frame_count` of entry point `npc.tick` come out in WIT as `framecount` and `frame-count`, which WIT takes as the same name
