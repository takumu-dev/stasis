interface test:use_cycle@1.0.0;

group world {
    use combat::{hit};
    record vec2 { x: f32, y: f32 }
}

group combat {
    use trade::{offer};
    record hit { damage: u32 }
}

group trade {
    use world::{vec2};
    record offer { price: u32 }
}

group alone {
    use alone::{thing};
    record thing { x: u8 }
}

script npc { fn tick(); }

