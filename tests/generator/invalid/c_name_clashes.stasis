interface test:clashes@1.0.0;

group world {
    object entity {
        fn find();
    }
    fn entity_find();
    record entity_name { x: u8 }
    object entity_two {}
    fn twice();
    fn twice();
}

group world_entity {
    fn name();
    record two { x: u8 }
    fn find();
}

group npc_tick {
    fn now();
}

group helpers {
    record label { text: string }
    record wrapped { inner: label }
    record plain { x: u8 }
    fn label_free();
    fn wrapped_free();
    fn plain_free();
}

group types {
    record sizes { uint8_t: u8, stasis_string: u8 }
    fn sized(uint32_t: u32, test_clashes_world_entity: u8);
}

script npc {
    uses world, types;
    fn tick_now();
    fn run(stasis_call: u32, int64_t: s64);
}


